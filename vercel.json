{
  "version": 2,
  "builds": [
    { "src": "api/proxy.js",              "use": "@vercel/node" },
    { "src": "api/auth.js",               "use": "@vercel/node" },
    { "src": "api/callback.js",           "use": "@vercel/node" },
    { "src": "api/logout.js",             "use": "@vercel/node" },
    { "src": "api/token.js",              "use": "@vercel/node" },
    { "src": "api/makemodel.js",          "use": "@vercel/node" },
    { "src": "api/history.js",            "use": "@vercel/node" },
    { "src": "api/parts.js",              "use": "@vercel/node" },
    { "src": "api/suppliers.js",          "use": "@vercel/node" },
    { "src": "api/materials-exclude.js",  "use": "@vercel/node" },
    { "src": "api/taskengagement.js", "use": "@vercel/node" }
    { "src": "public/index.html",         "use": "@vercel/static" },
    { "src": "public/jobs.html",          "use": "@vercel/static" },
    { "src": "public/tasks.html",         "use": "@vercel/static" },
    { "src": "public/parts.html",         "use": "@vercel/static" },
    { "src": "public/suppliers.html",     "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/auth",                 "dest": "/api/auth.js" },
    { "src": "/api/callback",             "dest": "/api/callback.js" },
    { "src": "/api/logout",               "dest": "/api/logout.js" },
    { "src": "/api/makemodel",            "dest": "/api/makemodel.js" },
    { "src": "/api/history",              "dest": "/api/history.js" },
    { "src": "/api/parts",                "dest": "/api/parts.js" },
    { "src": "/api/suppliers/entry",      "dest": "/api/suppliers.js" },
    { "src": "/api/suppliers",            "dest": "/api/suppliers.js" },
    { "src": "/api/materials-exclude",    "dest": "/api/materials-exclude.js" },
    { "src": "/api/taskengagement",       "dest": "/api/taskengagement.js" },
    { "src": "/api/(.*)",                 "dest": "/api/proxy.js" },
    { "src": "/tasks.html",               "dest": "/public/tasks.html" },
    { "src": "/jobs.html",                "dest": "/public/jobs.html" },
    { "src": "/parts.html",               "dest": "/public/parts.html" },
    { "src": "/suppliers.html",           "dest": "/public/suppliers.html" },
    { "src": "/(.*)",                     "dest": "/public/index.html" }
  ]
}
